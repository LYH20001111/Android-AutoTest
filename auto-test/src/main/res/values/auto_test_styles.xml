<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AutoTest.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/auto_test_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/auto_test_ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AutoTest.Main</item>
        <item name="android:statusBarColor">@color/auto_test_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AutoTest.Main" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/auto_test_splash_background</item>
        <item name="android:statusBarColor">@color/auto_test_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="TabLayoutTextStyle" parent="Widget.Design.TabLayout">
        <item name="android:textSize">15sp</item>
    </style>

    <!--文字颜色和大小-->
    <style name="ontextoff" parent="Theme.AppCompat.Light">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="scstyle" parent="Theme.AppCompat.Light">
        <!--开启时的颜色-->
        <item name="colorControlActivated">@color/green</item>
        <!--关闭时的颜色-->
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
        <!--关闭时的轨迹颜色-->
        <!--        <item name="android:colorForeground">#ecd502</item>-->
    </style>

</resources>