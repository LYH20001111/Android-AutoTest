<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray"
    android:orientation="vertical">


    <ScrollView
        android:id="@+id/sv_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:fillViewport="true"
        android:fadeScrollbars="false"
        android:scrollbarSize="10dp">

        <LinearLayout
            android:id="@+id/ll_base_function"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@color/gray"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="5dp"
                android:textColor="#6E5454"
                android:background="@color/gray"
                android:textSize="17sp"
                android:text="@string/base_function"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/auto_test_rounded_background"
                android:padding="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_debug_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Switch
                        android:id="@+id/sw_debug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:minHeight="30dp"
                        android:paddingStart="10dp"
                        android:text="@string/debug_mode"
                        android:checked="true"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:thumb="@drawable/auto_test_switch_custom_thumb_selector"
                        android:track="@drawable/auto_test_switch_custom_track_selector"
                        tools:ignore="RtlSymmetry,UseSwitchCompatOrMaterialXml" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_height="2dp"
                        android:visibility="visible"
                        android:background="#dfdfdf"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_export_report"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/auto_test_ripple_effect"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:minHeight="30dp"
                        android:paddingStart="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_export_report"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:text="输出测试报告"/>

<!--                        <ImageButton-->
<!--                            android:id="@+id/imbtn_select_export_report_mode"-->
<!--                            android:layout_width="wrap_content"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:gravity="center"-->
<!--                            android:layout_gravity="center"-->
<!--                            android:background="@drawable/auto_test_navigate_next"-->
<!--                            android:clickable="false"-->
<!--                            android:focusable="false"-->
<!--                            android:focusableInTouchMode="false" />-->
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_height="2dp"
                        android:visibility="visible"
                        android:background="#dfdfdf"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_report"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/auto_test_ripple_effect"
                    android:orientation="vertical">

                    <ExpandableListView
                        android:id="@+id/elv_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:groupIndicator="@null"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_height="2dp"
                        android:visibility="visible"
                        android:background="#dfdfdf"/>
                </LinearLayout>
                >
            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="5dp"
                android:textColor="#6E5454"
                android:background="@color/gray"
                android:textSize="17sp"
                android:text="设置"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/auto_test_rounded_background"
                android:padding="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/auto_test_ripple_effect"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_permission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:minHeight="30dp"
                        android:paddingStart="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:text="权限设置"/>

<!--                        <ImageButton-->
<!--                            android:layout_width="wrap_content"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:gravity="center"-->
<!--                            android:layout_gravity="center"-->
<!--                            android:background="@drawable/auto_test_navigate_next"-->
<!--                            android:clickable="false"-->
<!--                            android:focusable="false"-->
<!--                            android:focusableInTouchMode="false" />-->
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_height="2dp"
                        android:visibility="visible"
                        android:background="#dfdfdf"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

</LinearLayout>