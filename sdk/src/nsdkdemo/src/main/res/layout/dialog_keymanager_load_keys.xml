                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/linear_keymanager_loadAsymDefaultKeyID_Params">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/dialog_tv_key_id"
                        android:gravity="center_vertical"/>
                    <Spinner
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="center"
                        android:entries="@array/AsymKeyID"
                        android:id="@+id/spn_keymanager_load_asym_defaultKeyID"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/linear_keymanager_load_asym_editKeyID_params">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/dialog_tv_key_id"
                        android:gravity="center_vertical"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textAlignment="center"
                        android:id="@+id/et_keymanager_load_asym_editKeyID"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/dialog_tv_key_usage"
                        android:gravity="center_vertical"/>
                    <Spinner
