                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/linear_keymanager_load_symm_keys_by_kek_params">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_tv_keymanager_load_keys_by_kek"/>
                <LinearLayout
