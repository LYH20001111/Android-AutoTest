                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:text="@string/dialog_tv_key_len"/>
                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textAlignment="center"
                        android:entries="@array/KeyLen"
                        android:id="@+id/spn_keymanager_loadSymmOfAsym_keyLen"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/dialog_tv_kcv_mode"
                        android:gravity="center_vertical"/>
                    <Spinner
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textAlignment="center"
                        android:entries="@array/KCVMode"
                        android:id="@+id/spn_keymanager_loadSymmOfAsym_kcvMode"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/linear_keymanager_loadSymmOfAsym_kcvData_params">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/dialog_tv_kcv_data"
                        android:gravity="center_vertical"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/et_keymanager_loadSymmOfAsym_kcvData"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

