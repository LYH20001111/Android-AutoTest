                        android:text="@string/dialog_tv_key_usage"/>
                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textAlignment="center"
                        android:entries="@array/KeyUsage"
                        android:spinnerMode="dialog"
                        android:id="@+id/spn_keymanager_loadSymmOfAsym_keyUsage"/>
