    <uses-permission android:name="android.permission.READ_NETWORK_USAGE_HISTORY" />
    <uses-permission android:name="android.permission.SET_PREFERRED_APPLICATIONS" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/sdkdemo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".internal.activity.CameraActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat"/>
        <activity
            android:name=".common.MainActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".internal.activity.PINEntry2KeyboardActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".internal.activity.PINEntry2SecondDisplayActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            />
        <activity
            android:name=".internal.activity.KeyBoardNumberActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".external.activity.BTActivity" />
        <activity
            android:name=".internal.activity.SecondDisplayRNIBActivity"
            android:theme="@style/Theme.AppCompat.Dialog.Alert" />
        <activity
            android:name=".internal.activity.SecondDisplayActivity"
            android:theme="@style/Theme.AppCompat.Dialog.Alert" />
        
        <provider
            android:authorities="com.newland.nsdkdemo.fileprovider"
            android:name="android.support.v4.content.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>