<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.newland.mtype</groupId>
        <artifactId>nmjs</artifactId>
        <version>${mesdk.version}-RELEASE</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <name>Newland ME Series SDK</name>
    <artifactId>mesdk</artifactId>
    <packaging>apklib</packaging>
    <build>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>
        <resources>
            <resource>
                <directory>${basedir}/res/raw/</directory>
                <targetPath>${basedir}./../buildTask/src/</targetPath>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/newland/mtype/BuildConfig.java</exclude>
                        <exclude>com/newland/mtype/R.java</exclude>
						<exclude>com/newland/sdk/ModuleManage.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <executions>
                    <execution> <!-- 废掉默认声称的apklib,而使用proguard生成的混淆包进行安装 -->
                        <id>default-install</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>2.3.1</version>
                <executions>
                    <execution><!-- 安装proguard生成的混淆包 -->
                        <id>custom-install</id>
                        <phase>install</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>
                                ${project.build.directory}/mesdk-${project.version}_obfuscated.jar
                            </file>
                            <generatePom>false</generatePom>
                            <pomFile>pom.xml</pomFile>
                            <packaging>jar</packaging>
                            <version>${project.version}</version>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <tasks>
                                <move
                                    file="${basedir}/target/MESDK-${project.version}_obfuscated.jar"
                                    tofile="${basedir}/target/MESDK-${project.version}.jar" />
                            </tasks>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.jayway.maven.plugins.android.generation2</groupId>
                <artifactId>android-maven-plugin</artifactId>
                <configuration>
                    <proguard>
                        <skip>false</skip>
                        <jvmArguments>
                            <jvmArgument>-Xms256m</jvmArgument>
                            <jvmArgument>-Xmx512m</jvmArgument>
                        </jvmArguments>
                    </proguard>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <id>eng</id>
            <dependencies>
                <dependency>
                    <groupId>com.newland.mtype</groupId>
                    <artifactId>mtype-sdk-api</artifactId>
                    <version>${project.version}</version>
                    <type>jar</type>
                    <exclusions>
                        <exclusion>
                            <groupId>com.newland</groupId>
                            <artifactId>k21-driver</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.newland</groupId>
                            <artifactId>k21Transation</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.newland</groupId>
                            <artifactId>newland</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.newland.intelLib</groupId>
                            <artifactId>intelligentLibrary</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.newland.ndk</groupId>
                            <artifactId>ndk</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>com.newland.mtype</groupId>
                    <artifactId>deviceModule</artifactId>
                    <version>${project.version}</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>com.newland.mtype</groupId>
                    <artifactId>scanModule</artifactId>
                    <version>${scan.version}-RELEASE</version>
                    <type>jar</type>
                </dependency>
                <dependency>
                    <groupId>com.android.support</groupId>
                    <artifactId>support-annotations</artifactId>
                    <version>28.0.0</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
    <dependencies>
        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>android</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Support library (aka compatibility library) from the central repository as well
              note that this uses default scope (NOT provided) since the library will need to be added to your apk -->
            <groupId>com.google.android</groupId>
            <artifactId>support-v4</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.newland.uartport</groupId>
            <artifactId>UartPort</artifactId>
        </dependency>
        <dependency>
            <groupId>com.newland.bletoothbase</groupId>
            <artifactId>bletoothbase</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
