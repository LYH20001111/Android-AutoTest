<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <name>Newland MType Java SDK</name>
  <description>Newland MType Java SDK</description>
  <artifactId>nmjs</artifactId>
  <groupId>com.newland.mtype</groupId>
  <version>${mesdk.version}-RELEASE</version>
  <packaging>pom</packaging>
  <organization>
    <name>NewLandComputer</name>
    <url>http://www.newlandcomputer.com</url>
  </organization>
  <inceptionYear>2013</inceptionYear>
  <modules>
    <module>nmjs-api</module>
    <module>devicemodule</module>
    <module>scanmodule</module>
    <module>meEMVModule</module>
    <module>mesdk</module>
    <module>sdkutils</module>
  </modules>
  <build>
    <plugins>
      <!-- compile plugins -->      
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>2.9</version>
        <configuration>
		  <additionalparam>-Xdoclint:none</additionalparam>
          <additionalJOptions>
            <additionalJOption>-J-Duser.language=en_US</additionalJOption>
          </additionalJOptions>
          <excludePackageNames>
            *com.newland.sdk.common.RunningModel,
            *com.newland.iso*,
            *com.newland.mesdk*,
            *com.newland.mtype*,
            *com.newland.sdk.me*,
            *com.newland.sdk.me2*,
            *com.newland.sdk.mtype.*,
            *com.newland.sdk.module.emv.structure*,
            *com.newland.sdk.module.externalScan*,
            *com.newland.sdk.mtype.util.*,
            *com.newland.sdk.mtypex*,

            *com.newland.sdk.module.cardreader*,
            *com.newland.sdk.module.cashbox*,
            *com.newland.sdk.module.devicebasic*,
            *com.newland.sdk.module.emv*,
            *com.newland.sdk.module.externalGuestDisplay*,
            *com.newland.sdk.module.externalKeyboard*,          
            *com.newland.sdk.module.externalsignature*,
            *com.newland.sdk.module.iccard*,
            *com.newland.sdk.module.light*,
            *com.newland.sdk.module.printer*,
            *com.newland.sdk.module.rfcard*,
            *com.newland.sdk.module.scanner*,
            *com.newland.sdk.module.serialport*,
            *com.newland.sdk.module.sm*,
            *com.newland.sdk.module.swiper*,
            *com.newland.sdk.module.usb*,
            *com.newland.sdk.utils*,
			
			*com.newland.sdk.module.buzzer*,
			*com.newland.sdk.module.displayScreen*,
			*com.newland.sdk.module.pin*,
          </excludePackageNames>
          <aggregate>true</aggregate>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <!-- resources plugins -->  
      <plugin>
       <groupId>org.apache.maven.plugins</groupId>
       <artifactId>maven-resources-plugin</artifactId>
       <version>2.4</version>
       <configuration>
         <encoding>UTF-8</encoding>
       </configuration>
      </plugin>
      <!-- test plugins -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.14</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit47</artifactId>
            <version>2.14</version>
          </dependency>
        </dependencies>
        <configuration>
         <includes>
           <include>**/*TestCase.class</include>
         </includes>
       </configuration>
      </plugin>
      <!-- site plugins -->
      <plugin>
       <groupId>org.apache.maven.plugins</groupId>
       <artifactId>maven-site-plugin</artifactId>
       <version>3.2</version>
       <configuration>
         <locales>zh_CN</locales>
         <outputEncoding>UTF-8</outputEncoding>
       </configuration>
      </plugin>
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>2.3.1</version>
      </plugin>
      <plugin>
        <groupId>com.jayway.maven.plugins.android.generation2</groupId>
        <artifactId>android-maven-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <sdk>
            <platform>14</platform>
          </sdk>
          <undeployBeforeDeploy>true</undeployBeforeDeploy>
        </configuration>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
  <dependencyManagement>
    <dependencies>
      <!-- android sdk -->
      <dependency>
        <!-- Support library (aka compatibility library) from the central repository as well
          note that this uses default scope (NOT provided) since the library will need to be added to your apk -->
        <groupId>com.google.android</groupId>
        <artifactId>support-v4</artifactId>
        <version>r7</version>
      </dependency>
      <dependency>
        <groupId>com.android.support</groupId>
        <artifactId>support-annotations</artifactId>
        <version>28.0.0</version>
      </dependency>
      <dependency>
        <groupId>com.google.android</groupId>
        <artifactId>android</artifactId>
        <version>5.0</version>
      </dependency>
      <!-- android sdk end-->
      <dependency>
        <groupId>com.newland</groupId>
        <artifactId>k21-driver</artifactId>
        <version>1.0</version>
      </dependency>
      <dependency>
        <groupId>com.newland</groupId>
        <artifactId>k21Transation</artifactId>
        <version>1.0</version>
      </dependency>
	   	<dependency>
        <groupId>com.newland</groupId>
        <artifactId>newland</artifactId>
        <version>1.0</version>
      </dependency>
	   <dependency>
        <groupId>com.newland.intelLib</groupId>
        <artifactId>intelligentLibrary</artifactId>
        <version>1.0</version>
      </dependency>
	   <dependency>
        <groupId>com.newland.ndk</groupId>
        <artifactId>ndk</artifactId>
        <version>1.0</version>
      </dependency>
      <!-- test-->
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.0</version>
        <scope>test</scope>
      </dependency>
	  <dependency>
			<groupId>com.newland.emv</groupId>
			<artifactId>EmvJNIService</artifactId>
			<version>4.0.8</version>
		</dependency>
      <!-- test end -->
    </dependencies>
  </dependencyManagement>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mesdk.version>3.10.01</mesdk.version>
    <scan.version>1.0.01</scan.version>
    <android.sdk.path>C:\Work\Android\sdk</android.sdk.path>
    <android.ndk.path>Users/lindan/Documents/Android/development/android-ndk-r10b</android.ndk.path>
    <android.ndk.cmd>/Users/lindan/Documents/Android/development/android-ndk-r10b/ndk-build </android.ndk.cmd> </properties>
</project>

