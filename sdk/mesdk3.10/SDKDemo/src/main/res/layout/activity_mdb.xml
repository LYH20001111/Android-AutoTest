<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">
    <TextView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:id="@+id/tv_base"/>
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
        <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="Clear Message"
                android:textAllCaps="false"
                android:id="@+id/btn_clearMessage"/>
        <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
    </LinearLayout>
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginLeft="5dp"
                        android:text="Init Module"
                        android:textAllCaps="false"
                        android:id="@+id/btn_initModule"/>
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:text="Just Reset(Only first Time)"
                        android:textAllCaps="false"
                        android:id="@+id/btn_justReset"/>
            </LinearLayout>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:text="Begin Session"
                        android:textAllCaps="false"
                        android:id="@+id/btn_beginSession"/>
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:text="Cancel Session"
                        android:textAllCaps="false"
                        android:id="@+id/btn_cancelSession"/>

            </LinearLayout>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:text="Vend Deny"
                        android:textAllCaps="false"
                        android:id="@+id/btn_vendDeny"/>
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:text="Data Entry"
                        android:textAllCaps="false"
                        android:id="@+id/btn_dataEntry"/>

            </LinearLayout>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:text="Request Selection"
                        android:textAllCaps="false"
                        android:id="@+id/btn_requestSelection"/>
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:text="Report Coupon"
                        android:textAllCaps="false"
                        android:id="@+id/btn_reportCouponInfo"/>
            </LinearLayout>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="start"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:text="FTL Command"
                        android:textAllCaps="false"
                        android:id="@+id/btn_ftlCommands"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>