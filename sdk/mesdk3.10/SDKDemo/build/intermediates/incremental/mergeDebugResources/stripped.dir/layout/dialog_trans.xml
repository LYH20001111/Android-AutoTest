<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_tv_transtype"
        android:textSize="20sp"
        android:layout_marginLeft="@dimen/dp10"/>

    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <RadioGroup
            android:id="@+id/radiogroup_transtype"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5sp"
            android:orientation="vertical"
            android:layout_marginLeft="@dimen/dp10">
            <RadioButton
                android:id="@+id/radio_consume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="consume"
                android:textColor="@android:color/black" />

            <RadioButton
                android:id="@+id/radio_simple_flow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="simple flow"
                android:textColor="@android:color/black" />


            <RadioButton
                android:id="@+id/radio_acc_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="account info"
                android:textColor="@android:color/black" />

            <RadioButton
                android:id="@+id/radio_pboclog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="pboc logs"
                android:textColor="@android:color/black" />

            <RadioButton
                android:id="@+id/radio_eclog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EC logs"
                android:textColor="@android:color/black" />
        </RadioGroup>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10sp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingRight="15sp"
            android:text="@string/dialog_tv_amount"
            android:textColor="@android:color/black"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/edit_amt_trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8sp"
            android:layout_weight="1"
            android:text="0.01"
            android:singleLine="true"
            android:textColor="@android:color/black"
            android:textSize="20sp"></EditText>
    </LinearLayout>
</LinearLayout>
