<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/id_upperhalf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#f0f0f0"
        android:orientation="vertical">

        <TextView
            android:id="@+id/id_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#333"
            android:textSize="0sp" />
        <TextView
            android:id="@+id/id_displaymsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#333"
            android:textSize="0sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <TextView
            android:id="@+id/id_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:padding="10dp"
            android:background="#fff"
            android:clickable="false"
            android:gravity="center"
            android:textColor="#333"
            android:textSize="30sp"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ps_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fff"
        android:visibility="gone"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/id_password2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:paddingBottom="5dp"
            android:paddingTop="5dp"
            android:text="@string/keyboard_enterpwd"
            android:textColor="#FFA2A2A2"
            android:textSize="20sp" />
        <com.newland.sdk.pininput.PSView
            android:id="@+id/pstext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            />
    </LinearLayout>

    <com.newland.sdk.pininput.RNIBHorizontalPinKeyBoard
        android:id="@+id/id_pinkeyboard3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />
    <View
        android:layout_width="match_parent"
        android:layout_height="5dp"/>
</LinearLayout>